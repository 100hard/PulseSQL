# PulseSQL Configuration

# Database Connection (Defaults to local SQLite if omitted)
# For SQLite: sqlite:///pulsesql_edtech.db
# For PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/pulsesql_edtech
DATABASE_URL=sqlite:///pulsesql_edtech.db

# LLM Provider Configuration: 'openai', 'groq', 'gemini', or 'offline'
LLM_PROVIDER=offline

# API Keys (Provide according to selected LLM_PROVIDER)
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o

GROQ_API_KEY=
GROQ_MODEL_NAME=llama-3.3-70b-versatile

GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-1.5-pro

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
DASHBOARD_PORT=8501

# Self-Healing Execution Constraints
MAX_HEALING_ATTEMPTS=2
SQL_EXECUTION_TIMEOUT_SECONDS=15
MAX_RESULT_ROWS=1000
